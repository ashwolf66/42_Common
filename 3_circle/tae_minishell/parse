#include <stddef.h>

#include <stdio.h>

#include <stdlib.h>

#include <string.h>



#define INITIAL_CAPACITY 10



typedef enum

{

    TYPE_INT,

    TYPE_FLOAT,

    TYPE_CHAR,

    TYPE_STRING

}	ElementType;



typedef struct

{

    ElementType	type;

    union

    {

        int	i;

        float	f;

        char	c;

        char	*s;

    }	data;

}	Element;



typedef struct Vector

{

    Element*	elements;

    Element*	raw_ptr;

    size_t	size;

    size_t	capacity;



    void    (*push_back) (struct Vector *vec, Element elem);

    Element (*front) (struct Vector *vec);

    Element (*back) (struct Vector *vec);

    Element (*pop_front) (struct Vector *vec);

    Element (*pop_back) (struct Vector *vec);

    size_t  (*begin) (struct Vector *vec);

    size_t  (*end) (struct Vector *vec);

    Element (*at) (struct Vector *vec, size_t index);

}	ft_vector;



void ft_vector_init(ft_vector* vec);



ft_vector   *ft_vector_create()

{

    ft_vector   *vec = (ft_vector *)malloc(sizeof(ft_vector));

    vec->elements = (Element *)malloc(sizeof(Element) * INITIAL_CAPACITY);

    vec->raw_ptr = vec->elements;

    vec->size = 0;

    vec->capacity = INITIAL_CAPACITY;

    ft_vector_init(vec);

    return vec;

}



void ft_vector_push_back(ft_vector *vec, Element elem)

{

    if (vec->size == vec->capacity)

    {

        vec->capacity *= 2;

        vec->elements = (Element *)realloc(vec->elements, sizeof(Element) * vec->capacity);

        vec->raw_ptr = vec->elements;

    }

    vec->elements[vec->size++] = elem;

}



Element ft_vector_front(ft_vector *vec)

{

    return vec->elements[0];

}



Element ft_vector_back(ft_vector *vec)

{

    return vec->elements[vec->size - 1];

}



Element ft_vector_pop_front(ft_vector *vec)

{

    Element to_ret = ft_vector_front(vec);

    vec->elements++;

    vec->size--;

    return to_ret;

}



Element ft_vector_pop_back(ft_vector *vec)

{

    Element to_ret = ft_vector_back(vec);

    vec->size--;

    return to_ret;

}



size_t  ft_vector_iterator_begin(ft_vector *vec)

{

    (void)vec;

    return 0;

}



size_t  ft_vector_iterator_end(ft_vector *vec)

{

    return vec->size;

}



Element ft_vector_at(ft_vector* vec, size_t index)

{

    if (index >= vec->size)

    {

        fprintf(stderr, "Index out of bounds, returning last element\n");

        return vec->elements[vec->size];

    }

    return vec->elements[index];

}



size_t ft_vector_size(ft_vector* vec)

{

    return vec->size;

}



void ft_vector_init(ft_vector* vec)

{

    vec->push_back = ft_vector_push_back;

    vec->front = ft_vector_front;

    vec->back = ft_vector_back;

    vec->pop_front = ft_vector_pop_front;

    vec->pop_back = ft_vector_pop_back;

    vec->begin = ft_vector_iterator_begin;

    vec->end = ft_vector_iterator_end;

    vec->at = ft_vector_at;

}



void ft_vector_destroy(ft_vector* vec)

{

    for (size_t i = 0; i < vec->size; i++)

    {

        if (vec->elements[i].type == TYPE_STRING)

        {

            free(vec->elements[i].data.s);

        }

    }

    free(vec->elements);

    free(vec);

}



Element create_int(int value)

{

    Element e;

    e.type = TYPE_INT;

    e.data.i = value;

    return e;

}



Element create_float(float value)

{

    Element e;

    e.type = TYPE_FLOAT;

    e.data.f = value;

    return e;

}



Element create_char(char value)

{

    Element e;

    e.type = TYPE_CHAR;

    e.data.c = value;

    return e;

}



Element create_string(const char* value)

{

    Element e;

    e.type = TYPE_STRING;

    e.data.s = strdup(value);

    return e;

}



int main()

{

    ft_vector* vec = ft_vector_create();



    ft_vector_push_back(vec, create_int(42));

    ft_vector_push_back(vec, create_float(3.14f));

    ft_vector_push_back(vec, create_char('A'));

    ft_vector_push_back(vec, create_string("Hello"));



    for (size_t i = vec->begin(vec); i < vec->end(vec); i++)

    {

        Element e = vec->at(vec, i);

        switch (e.type)

	{

            case TYPE_INT:

                printf("Integer: %d\n", e.data.i);

                break;

            case TYPE_FLOAT:

                printf("Float: %f\n", e.data.f);

                break;

            case TYPE_CHAR:

                printf("Char: %c\n", e.data.c);

                break;

            case TYPE_STRING:

                printf("String: %s\n", e.data.s);

                break;

        }

    }



    ft_vector_destroy(vec);

    return 0;

}


