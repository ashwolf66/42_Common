[server]

[mysqld]

user                    = mysql
basedir                 = /usr

datadir                 = /var/lib/mysql
tmpdir                  = /tmp

bind-address            = 0.0.0.0

expire_logs_days        = 10
character-set-server    = utf8mb4
collation-server        = utf8mb4_general_ci

[embedded]

[mariadb]

[mariadb-10.11]

[client]
port                    = 3306